  "archivos_creados": {
    "config": {
      "session_security.php": {
        "descripcion": "12 funciones de validación y seguridad",
        "funciones": [
          "getSessionContext()",
          "getSessionEmpresa()",
          "getSessionFinca()",
          "canAccessEmpresa()",
          "canAccessFinca()",
          "canAccessRecord()",
          "buildSecureQuery()",
          "auditarAcceso()",
          "requireSessionContext()",
          "requireAccessEmpresa()",
          "requireAccessFinca()",
          "requireAccessEmpresaFinca()"
        ]
      }
    },
    "migrations": {
      "add_empresa_finca_isolation.sql": {
        "descripcion": "Agrega columnas codigo_empresa y codigo_finca a todas las tablas",
        "tablas_modificadas": [
          "usuario (+ codigo_empresa)",
          "cuarto_frio (+ codigo_empresa)",
          "sensor (+ codigo_empresa, + codigo_finca)",
          "reporte (+ codigo_empresa, + codigo_finca)",
          "componente (+ codigo_empresa, + codigo_finca)",
          "mantenimiento (+ codigo_empresa, + codigo_finca)"
        ],
        "tablas_nuevas": [
          "auditoria_acceso"
        ]
      },
      "populate_empresa_finca_data.sql": {
        "descripcion": "Puebla los nuevos campos basándose en relaciones FK"
      },
      "audit_and_validation_queries.sql": {
        "descripcion": "Scripts de auditoría, validación y compliance"
      }
    },
    "api": {
      "_TEMPLATE_SECURE_API.php": {
        "descripcion": "Template de endpoint seguro con todos los patrones",
        "operaciones": ["GET", "POST", "PUT", "DELETE"],
        "validaciones": [
          "requireAuth()",
          "requireSessionContext()",
          "canAccessRecord()",
          "buildSecureQuery()"
        ]
      }
    },
